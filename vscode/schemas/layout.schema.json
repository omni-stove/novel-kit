{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "小説プレビューの設定（レイアウト定義と表示設定）",
  "type": "object",
  "properties": {
    "writingMode": {
      "enum": [
        "vertical",
        "horizontal"
      ],
      "description": "文字方向（縦書き / 横書き）"
    },
    "paper": {
      "enum": [
        "A4",
        "B5",
        "A5",
        "B6",
        "A6",
        "6x9in",
        "5x8in"
      ],
      "description": "用紙サイズ（6x9in / 5x8in は英語ペーパーバックの判型）"
    },
    "orientation": {
      "enum": [
        "landscape",
        "portrait"
      ],
      "description": "用紙の向き"
    },
    "margin": {
      "type": "object",
      "description": "余白（mm）",
      "properties": {
        "top": {
          "type": "number"
        },
        "right": {
          "type": "number"
        },
        "bottom": {
          "type": "number"
        },
        "left": {
          "type": "number"
        }
      }
    },
    "chars": {
      "type": "integer",
      "minimum": 5,
      "maximum": 100,
      "description": "1行の文字数"
    },
    "lines": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 100,
      "description": "1ページの行数（null で行送り自動）"
    },
    "fontFamily": {
      "type": "string",
      "description": "本文フォント（空なら PDF 出力と同じ。日本語は明朝、英語は EB Garamond）"
    },
    "english": {
      "type": "object",
      "description": "英語の原稿（本文のアルファベットが日本語の文字より多いもの）のレイアウト。横書き固定で、文字サイズと行送りを指定する。省略時は 6×9in ペーパーバック",
      "properties": {
        "paper": {
          "enum": [
            "A4",
            "B5",
            "A5",
            "B6",
            "A6",
            "6x9in",
            "5x8in"
          ],
          "description": "用紙サイズ（6x9in / 5x8in は英語ペーパーバックの判型）"
        },
        "orientation": {
          "enum": [
            "landscape",
            "portrait"
          ],
          "description": "用紙の向き"
        },
        "margin": {
          "type": "object",
          "description": "余白（mm。見開きの内側を左、外側を右に置く）",
          "properties": {
            "top": {
              "type": "number"
            },
            "right": {
              "type": "number"
            },
            "bottom": {
              "type": "number"
            },
            "left": {
              "type": "number"
            }
          }
        },
        "fontSize": {
          "type": "number",
          "minimum": 5,
          "maximum": 40,
          "description": "本文の文字サイズ（pt）"
        },
        "lineHeight": {
          "type": "number",
          "minimum": 1,
          "maximum": 3,
          "description": "行送り（倍率）"
        },
        "fontFamily": {
          "type": "string",
          "description": "本文フォント（空なら PDF 出力と同じ EB Garamond）"
        }
      }
    },
    "view": {
      "type": "object",
      "description": "表示設定",
      "properties": {
        "scope": {
          "enum": [
            "work",
            "file"
          ],
          "description": "表示範囲（work: 同じディレクトリの本文ファイルを連結 / file: 開いているファイルだけ）"
        },
        "zoom": {
          "description": "表示倍率（fit: 画面に合わせる / 数値: %）",
          "anyOf": [
            {
              "enum": [
                "fit"
              ]
            },
            {
              "enum": [
                "fit-width",
                "fit-page"
              ],
              "deprecated": true,
              "description": "旧い値。fit として扱う"
            },
            {
              "type": "number",
              "minimum": 10,
              "maximum": 400
            }
          ]
        },
        "edit": {
          "type": "boolean",
          "description": "プレビュー上で段落をクリックして編集する"
        }
      }
    }
  }
}
