{
  "name": "novel-preview",
  "displayName": "小説プレビュー",
  "description": "原稿テキスト（.txt）を PDF 出力と同じ組版でページ表示する。字数×行数などのレイアウトは Word のページ設定のように定義できる。英語原稿は自動判定してペーパーバック風の組版にする。",
  "version": "0.0.0",
  "publisher": "omnistove",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#F4EFE4",
    "theme": "light"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/omni-stove/novel-kit.git",
    "directory": "vscode"
  },
  "bugs": {
    "url": "https://github.com/omni-stove/novel-kit/issues"
  },
  "homepage": "https://github.com/omni-stove/novel-kit/tree/main/vscode#readme",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:plaintext",
    "workspaceContains:**/novel.json"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "novelPreview.editor",
        "displayName": "小説プレビュー",
        "selector": [
          {
            "filenamePattern": "*.txt"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "novelPreview.workSettings",
        "displayName": "作品の設定",
        "selector": [
          {
            "filenamePattern": "novel.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "novelPreview.open",
        "title": "小説プレビューを横に開く",
        "category": "小説",
        "icon": "$(open-preview)"
      },
      {
        "command": "novelPreview.reopenAsPreview",
        "title": "小説プレビューに切り替える",
        "category": "小説",
        "icon": "$(book)"
      },
      {
        "command": "novelPreview.selectLayout",
        "title": "レイアウト（字数×行数）を選ぶ",
        "category": "小説"
      },
      {
        "command": "novelPreview.exportPdf",
        "title": "現在のレイアウトでPDFを出力",
        "category": "小説"
      },
      {
        "command": "novelPreview.openWorkSettings",
        "title": "作品の設定を開く",
        "category": "小説",
        "icon": "$(settings-gear)"
      },
      {
        "command": "novelPreview.showPanel",
        "title": "小説パネルを開く",
        "category": "小説",
        "icon": "$(graph)"
      },
      {
        "command": "novelPreview.build",
        "title": "novel.json の出力を作る",
        "category": "小説",
        "icon": "$(package)"
      },
      {
        "command": "novelPreview.insertRuby",
        "title": "ルビを振る",
        "category": "小説"
      },
      {
        "command": "novelPreview.insertEmphasis",
        "title": "傍点を打つ",
        "category": "小説"
      },
      {
        "command": "novelPreview.nextFile",
        "title": "次のファイルを開く",
        "category": "小説",
        "icon": "$(arrow-down)"
      },
      {
        "command": "novelPreview.previousFile",
        "title": "前のファイルを開く",
        "category": "小説",
        "icon": "$(arrow-up)"
      },
      {
        "command": "novelPreview.openFromOutline",
        "title": "目次から開く",
        "category": "小説"
      },
      {
        "command": "novelPreview.moveUp",
        "title": "上へ移動",
        "category": "小説",
        "icon": "$(arrow-up)"
      },
      {
        "command": "novelPreview.moveDown",
        "title": "下へ移動",
        "category": "小説",
        "icon": "$(arrow-down)"
      },
      {
        "command": "novelPreview.renumberFiles",
        "title": "ファイル名の番号を振り直す",
        "category": "小説",
        "icon": "$(list-ordered)"
      },
      {
        "command": "novelPreview.revealLine",
        "title": "原稿の行を開く",
        "category": "小説"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "novelPreview.open",
          "when": "resourceExtname == .txt && activeCustomEditorId != novelPreview.editor",
          "group": "navigation"
        },
        {
          "command": "novelPreview.reopenAsPreview",
          "when": "resourceExtname == .txt && activeCustomEditorId != novelPreview.editor",
          "group": "navigation"
        },
        {
          "command": "novelPreview.openWorkSettings",
          "when": "resourceFilename == novel.json && activeCustomEditorId != novelPreview.workSettings",
          "group": "navigation"
        },
        {
          "command": "novelPreview.showPanel",
          "when": "resourceExtname == .txt",
          "group": "2_novel@0"
        },
        {
          "command": "novelPreview.openWorkSettings",
          "when": "resourceExtname == .txt",
          "group": "2_novel@1"
        },
        {
          "command": "novelPreview.build",
          "when": "resourceExtname == .txt || resourceFilename == novel.json",
          "group": "2_novel@2"
        },
        {
          "command": "novelPreview.exportPdf",
          "when": "resourceExtname == .txt",
          "group": "2_novel@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "novelPreview.reopenAsPreview",
          "when": "resourceExtname == .txt && activeCustomEditorId != novelPreview.editor",
          "group": "1_open"
        }
      ],
      "commandPalette": [
        {
          "command": "novelPreview.open",
          "when": "resourceExtname == .txt && activeCustomEditorId != novelPreview.editor"
        },
        {
          "command": "novelPreview.reopenAsPreview",
          "when": "resourceExtname == .txt && activeCustomEditorId != novelPreview.editor"
        },
        {
          "command": "novelPreview.selectLayout",
          "when": "resourceExtname == .txt"
        },
        {
          "command": "novelPreview.exportPdf",
          "when": "resourceExtname == .txt"
        },
        {
          "command": "novelPreview.insertRuby",
          "when": "resourceExtname == .txt && activeCustomEditorId != novelPreview.editor"
        },
        {
          "command": "novelPreview.insertEmphasis",
          "when": "resourceExtname == .txt && activeCustomEditorId != novelPreview.editor"
        },
        {
          "command": "novelPreview.nextFile",
          "when": "resourceExtname == .txt"
        },
        {
          "command": "novelPreview.previousFile",
          "when": "resourceExtname == .txt"
        },
        {
          "command": "novelPreview.openFromOutline",
          "when": "false"
        },
        {
          "command": "novelPreview.moveUp",
          "when": "false"
        },
        {
          "command": "novelPreview.moveDown",
          "when": "false"
        },
        {
          "command": "novelPreview.renumberFiles",
          "when": "novelPreview.hasManuscript"
        },
        {
          "command": "novelPreview.revealLine",
          "when": "false"
        },
        {
          "command": "novelPreview.openWorkSettings",
          "when": "resourceExtname == .txt || resourceFilename == novel.json || novelPreview.hasManuscript"
        },
        {
          "command": "novelPreview.showPanel",
          "when": "novelPreview.hasManuscript"
        }
      ],
      "editor/context": [
        {
          "command": "novelPreview.insertRuby",
          "when": "resourceExtname == .txt",
          "group": "1_novel@1"
        },
        {
          "command": "novelPreview.insertEmphasis",
          "when": "resourceExtname == .txt",
          "group": "1_novel@2"
        }
      ],
      "view/title": [
        {
          "command": "novelPreview.previousFile",
          "when": "view == novelPreview.outline",
          "group": "navigation@1"
        },
        {
          "command": "novelPreview.nextFile",
          "when": "view == novelPreview.outline",
          "group": "navigation@2"
        },
        {
          "command": "novelPreview.renumberFiles",
          "when": "view == novelPreview.outline",
          "group": "1_order@1"
        }
      ],
      "view/item/context": [
        {
          "command": "novelPreview.moveUp",
          "when": "view == novelPreview.outline && viewItem == manuscript",
          "group": "1_order@1"
        },
        {
          "command": "novelPreview.moveDown",
          "when": "view == novelPreview.outline && viewItem == manuscript",
          "group": "1_order@2"
        }
      ],
      "explorer/context": [
        {
          "command": "novelPreview.openWorkSettings",
          "when": "resourceFilename == novel.json",
          "group": "navigation@89"
        },
        {
          "command": "novelPreview.build",
          "when": "resourceFilename == novel.json",
          "group": "navigation@90"
        }
      ]
    },
    "keybindings": [
      {
        "command": "novelPreview.open",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "resourceExtname == .txt && activeCustomEditorId != novelPreview.editor"
      },
      {
        "command": "novelPreview.insertRuby",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus && !editorReadonly && resourceExtname == .txt"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "novel.json",
        "url": "./schemas/novel.schema.json"
      }
    ],
    "configuration": {
      "title": "小説プレビュー",
      "properties": {
        "novelPreview.defaultPreset": {
          "type": "string",
          "default": "標準（30字・行数自動）",
          "description": "原稿から上へたどっても novel.json が見つからないときに使うプリセット名。"
        },
        "novelPreview.presets": {
          "type": "object",
          "default": {},
          "markdownDescription": "追加のレイアウトプリセット（名前 → 定義）。プレビューの「ページ設定 > プリセットとして保存」でも追加できる。`\"english\": true` のものは英語の原稿用。",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "english": {
                "type": "boolean",
                "description": "英語のレイアウト（用紙・余白・fontSize・lineHeight）。英語の原稿のときだけ出す"
              },
              "writingMode": {
                "enum": [
                  "vertical",
                  "horizontal"
                ],
                "description": "文字方向（縦書き / 横書き。英語は横書き固定）"
              },
              "paper": {
                "enum": [
                  "A4",
                  "B5",
                  "A5",
                  "B6",
                  "A6",
                  "6x9in",
                  "5x8in"
                ],
                "description": "用紙サイズ（6x9in / 5x8in は英語ペーパーバックの判型）"
              },
              "orientation": {
                "enum": [
                  "landscape",
                  "portrait"
                ],
                "description": "用紙の向き"
              },
              "margin": {
                "type": "object",
                "description": "余白（mm）",
                "properties": {
                  "top": {
                    "type": "number"
                  },
                  "right": {
                    "type": "number"
                  },
                  "bottom": {
                    "type": "number"
                  },
                  "left": {
                    "type": "number"
                  }
                }
              },
              "chars": {
                "type": "integer",
                "description": "1行の文字数"
              },
              "lines": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "1ページの行数（null で行送り自動）"
              },
              "fontSize": {
                "type": "number",
                "description": "英語のレイアウトの本文の文字サイズ（pt）"
              },
              "lineHeight": {
                "type": "number",
                "description": "英語のレイアウトの行送り（倍率）"
              },
              "fontFamily": {
                "type": "string",
                "description": "本文フォント（空なら PDF 出力と同じ。日本語は明朝、英語は EB Garamond）"
              }
            }
          }
        },
        "novelPreview.prose": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "小説パネルの「文章の傾向」で、地の文の文末の分布などを形態素解析で数える。形態素解析の辞書はそのタブを初めて見せたときに読み込み、メモリを約250MB使うので、重いときはオフにする（使っていたメモリは、ウィンドウを再読み込みすると戻る）。オフでも文字数は出す"
        },
        "novelPreview.outDir": {
          "type": "string",
          "default": "out",
          "markdownDescription": "「novel.json の出力を作る」の出力先。ワークスペースのフォルダから（絶対パスも可）。`novel build` の `--out-dir` と同じ"
        },
        "novelPreview.openAfterExport": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "出力した PDF・RTF を開く（「現在のレイアウトでPDFを出力」も同じ。EPUB と split / merge の txt は `novel build` と同じく開かない）。環境変数 `AUTO_OPEN=0` のときは開かない"
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "novelPreview.outline",
          "name": "小説の目次",
          "when": "novelPreview.hasManuscript",
          "icon": "$(book)"
        }
      ]
    }
  },
  "scripts": {
    "bundle": "esbuild src/extension.mjs src/novel-cli.mjs src/pdf-renderer.mjs --bundle --platform=node --format=cjs --target=node20 --external:vscode --define:import.meta.vitest=undefined --log-override:empty-import-meta=silent --outdir=dist --out-extension:.js=.cjs",
    "build": "pnpm run bundle && node -e \"const fs = require('fs'), path = require('path'); fs.rmSync('dist/viewer', { recursive: true, force: true }); fs.cpSync(path.join(path.dirname(require.resolve('@vivliostyle/viewer/package.json')), 'lib'), 'dist/viewer', { recursive: true }); fs.copyFileSync(path.join(path.dirname(require.resolve('lindera-wasm')), 'lindera_wasm_bg.wasm'), 'dist/lindera_wasm_bg.wasm'); fs.copyFileSync('../src/templates/tategaki-a4-42x34.docx', 'dist/tategaki-a4-42x34.docx')\" && node src/ipadic.mjs dist/ipadic",
    "watch": "pnpm run bundle --watch=forever",
    "package": "pnpm run build && npx --yes @vscode/vsce package --no-dependencies --baseContentUrl https://github.com/omni-stove/novel-kit/blob/HEAD/vscode --baseImagesUrl https://github.com/omni-stove/novel-kit/raw/HEAD/vscode -o dist/novel-preview.vsix",
    "install-extension": "pnpm run package && code --install-extension dist/novel-preview.vsix --force",
    "release": "pnpm --dir .. test && pnpm run package && gh release create \"vscode-v$npm_package_version\" dist/novel-preview.vsix --repo omni-stove/novel-kit --title \"小説プレビュー $npm_package_version\" --generate-notes",
    "publish": "pnpm run build && npx --yes @vscode/vsce publish --no-dependencies --baseContentUrl https://github.com/omni-stove/novel-kit/blob/HEAD/vscode --baseImagesUrl https://github.com/omni-stove/novel-kit/raw/HEAD/vscode"
  },
  "devDependencies": {
    "@puppeteer/browsers": "2.10.5",
    "@types/vscode": "~1.100.0",
    "@types/vscode-webview": "^1.57.5",
    "@vivliostyle/viewer": "2.42.1",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.2",
    "lindera-wasm": "6.2.0",
    "puppeteer-core": "24.27.0"
  },
  "keywords": [
    "小説",
    "縦書き",
    "ルビ",
    "原稿用紙",
    "PDF",
    "novel",
    "vertical writing",
    "manuscript",
    "Japanese",
    "Vivliostyle"
  ]
}
