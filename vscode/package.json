{
  "name": "novel-preview",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.0.0",
  "publisher": "omnistove",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#F4EFE4",
    "theme": "light"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/omni-stove/novel-kit.git",
    "directory": "vscode"
  },
  "bugs": {
    "url": "https://github.com/omni-stove/novel-kit/issues"
  },
  "homepage": "https://github.com/omni-stove/novel-kit/tree/main/vscode#readme",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "l10n": "./l10n",
  "activationEvents": [
    "onLanguage:plaintext",
    "workspaceContains:**/novel.json"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "novelPreview.editor",
        "displayName": "%customEditor.preview%",
        "selector": [
          {
            "filenamePattern": "*.txt"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "novelPreview.workSettings",
        "displayName": "%customEditor.workSettings%",
        "selector": [
          {
            "filenamePattern": "novel.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "novelPreview.open",
        "title": "%command.open%",
        "category": "%category%",
        "icon": "$(open-preview)"
      },
      {
        "command": "novelPreview.reopenAsPreview",
        "title": "%command.reopenAsPreview%",
        "category": "%category%",
        "icon": "$(book)"
      },
      {
        "command": "novelPreview.selectLayout",
        "title": "%command.selectLayout%",
        "category": "%category%"
      },
      {
        "command": "novelPreview.exportPdf",
        "title": "%command.exportPdf%",
        "category": "%category%"
      },
      {
        "command": "novelPreview.openWorkSettings",
        "title": "%command.openWorkSettings%",
        "category": "%category%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "novelPreview.showPanel",
        "title": "%command.showPanel%",
        "category": "%category%",
        "icon": "$(graph)"
      },
      {
        "command": "novelPreview.build",
        "title": "%command.build%",
        "category": "%category%",
        "icon": "$(package)"
      },
      {
        "command": "novelPreview.insertRuby",
        "title": "%command.insertRuby%",
        "category": "%category%"
      },
      {
        "command": "novelPreview.insertEmphasis",
        "title": "%command.insertEmphasis%",
        "category": "%category%"
      },
      {
        "command": "novelPreview.nextFile",
        "title": "%command.nextFile%",
        "category": "%category%",
        "icon": "$(arrow-down)"
      },
      {
        "command": "novelPreview.previousFile",
        "title": "%command.previousFile%",
        "category": "%category%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "novelPreview.openFromOutline",
        "title": "%command.openFromOutline%",
        "category": "%category%"
      },
      {
        "command": "novelPreview.moveUp",
        "title": "%command.moveUp%",
        "category": "%category%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "novelPreview.moveDown",
        "title": "%command.moveDown%",
        "category": "%category%",
        "icon": "$(arrow-down)"
      },
      {
        "command": "novelPreview.renumberFiles",
        "title": "%command.renumberFiles%",
        "category": "%category%",
        "icon": "$(list-ordered)"
      },
      {
        "command": "novelPreview.revealLine",
        "title": "%command.revealLine%",
        "category": "%category%"
      },
      {
        "command": "novelPreview.backup",
        "title": "%command.backup%",
        "category": "%category%",
        "icon": "$(cloud-upload)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "novelPreview.open",
          "when": "resourceExtname == .txt && activeCustomEditorId != novelPreview.editor && config.novelPreview.show.editorButtons",
          "group": "navigation"
        },
        {
          "command": "novelPreview.reopenAsPreview",
          "when": "resourceExtname == .txt && activeCustomEditorId != novelPreview.editor && config.novelPreview.show.editorButtons",
          "group": "navigation"
        },
        {
          "command": "novelPreview.openWorkSettings",
          "when": "resourceFilename == novel.json && activeCustomEditorId != novelPreview.workSettings && config.novelPreview.show.editorButtons",
          "group": "navigation"
        },
        {
          "command": "novelPreview.showPanel",
          "when": "resourceExtname == .txt",
          "group": "2_novel@0"
        },
        {
          "command": "novelPreview.openWorkSettings",
          "when": "resourceExtname == .txt",
          "group": "2_novel@1"
        },
        {
          "command": "novelPreview.build",
          "when": "resourceExtname == .txt || resourceFilename == novel.json",
          "group": "2_novel@2"
        },
        {
          "command": "novelPreview.exportPdf",
          "when": "resourceExtname == .txt",
          "group": "2_novel@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "novelPreview.reopenAsPreview",
          "when": "resourceExtname == .txt && activeCustomEditorId != novelPreview.editor",
          "group": "1_open"
        }
      ],
      "commandPalette": [
        {
          "command": "novelPreview.open",
          "when": "resourceExtname == .txt && activeCustomEditorId != novelPreview.editor"
        },
        {
          "command": "novelPreview.reopenAsPreview",
          "when": "resourceExtname == .txt && activeCustomEditorId != novelPreview.editor"
        },
        {
          "command": "novelPreview.selectLayout",
          "when": "resourceExtname == .txt"
        },
        {
          "command": "novelPreview.exportPdf",
          "when": "resourceExtname == .txt"
        },
        {
          "command": "novelPreview.insertRuby",
          "when": "resourceExtname == .txt && activeCustomEditorId != novelPreview.editor"
        },
        {
          "command": "novelPreview.insertEmphasis",
          "when": "resourceExtname == .txt && activeCustomEditorId != novelPreview.editor"
        },
        {
          "command": "novelPreview.nextFile",
          "when": "resourceExtname == .txt"
        },
        {
          "command": "novelPreview.previousFile",
          "when": "resourceExtname == .txt"
        },
        {
          "command": "novelPreview.openFromOutline",
          "when": "false"
        },
        {
          "command": "novelPreview.moveUp",
          "when": "false"
        },
        {
          "command": "novelPreview.moveDown",
          "when": "false"
        },
        {
          "command": "novelPreview.renumberFiles",
          "when": "novelPreview.hasManuscript"
        },
        {
          "command": "novelPreview.revealLine",
          "when": "false"
        },
        {
          "command": "novelPreview.openWorkSettings",
          "when": "resourceExtname == .txt || resourceFilename == novel.json || novelPreview.hasManuscript"
        },
        {
          "command": "novelPreview.showPanel",
          "when": "novelPreview.hasManuscript"
        },
        {
          "command": "novelPreview.backup",
          "when": "(novelPreview.hasManuscript || workspaceFolderCount > 0) && config.novelPreview.show.backup"
        }
      ],
      "editor/context": [
        {
          "command": "novelPreview.insertRuby",
          "when": "resourceExtname == .txt",
          "group": "1_novel@1"
        },
        {
          "command": "novelPreview.insertEmphasis",
          "when": "resourceExtname == .txt",
          "group": "1_novel@2"
        }
      ],
      "view/title": [
        {
          "command": "novelPreview.previousFile",
          "when": "view == novelPreview.outline",
          "group": "navigation@1"
        },
        {
          "command": "novelPreview.nextFile",
          "when": "view == novelPreview.outline",
          "group": "navigation@2"
        },
        {
          "command": "novelPreview.backup",
          "when": "view == novelPreview.outline && config.novelPreview.show.backup",
          "group": "navigation@3"
        },
        {
          "command": "novelPreview.renumberFiles",
          "when": "view == novelPreview.outline",
          "group": "1_order@1"
        }
      ],
      "view/item/context": [
        {
          "command": "novelPreview.moveUp",
          "when": "view == novelPreview.outline && viewItem == manuscript",
          "group": "1_order@1"
        },
        {
          "command": "novelPreview.moveDown",
          "when": "view == novelPreview.outline && viewItem == manuscript",
          "group": "1_order@2"
        }
      ],
      "explorer/context": [
        {
          "command": "novelPreview.openWorkSettings",
          "when": "resourceFilename == novel.json",
          "group": "navigation@89"
        },
        {
          "command": "novelPreview.build",
          "when": "resourceFilename == novel.json",
          "group": "navigation@90"
        }
      ]
    },
    "keybindings": [
      {
        "command": "novelPreview.open",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "resourceExtname == .txt && activeCustomEditorId != novelPreview.editor"
      },
      {
        "command": "novelPreview.insertRuby",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus && !editorReadonly && resourceExtname == .txt"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "novel.json",
        "url": "./schemas/novel.schema.json"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "novelPreview.defaultPreset": {
          "type": "string",
          "default": "標準（30字・行数自動）",
          "description": "%config.defaultPreset%"
        },
        "novelPreview.presets": {
          "type": "object",
          "default": {},
          "markdownDescription": "%config.presets%",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "english": {
                "type": "boolean",
                "description": "%config.presets.english%"
              },
              "writingMode": {
                "enum": [
                  "vertical",
                  "horizontal"
                ],
                "description": "%config.presets.writingMode%"
              },
              "paper": {
                "enum": [
                  "A4",
                  "B5",
                  "A5",
                  "B6",
                  "A6",
                  "6x9in",
                  "5x8in"
                ],
                "description": "%config.presets.paper%"
              },
              "orientation": {
                "enum": [
                  "landscape",
                  "portrait"
                ],
                "description": "%config.presets.orientation%"
              },
              "margin": {
                "type": "object",
                "description": "%config.presets.margin%",
                "properties": {
                  "top": {
                    "type": "number"
                  },
                  "right": {
                    "type": "number"
                  },
                  "bottom": {
                    "type": "number"
                  },
                  "left": {
                    "type": "number"
                  }
                }
              },
              "chars": {
                "type": "integer",
                "description": "%config.presets.chars%"
              },
              "lines": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "%config.presets.lines%"
              },
              "fontSize": {
                "type": "number",
                "description": "%config.presets.fontSize%"
              },
              "lineHeight": {
                "type": "number",
                "description": "%config.presets.lineHeight%"
              },
              "fontFamily": {
                "type": "string",
                "description": "%config.presets.fontFamily%"
              }
            }
          }
        },
        "novelPreview.prose": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.prose%"
        },
        "novelPreview.outDir": {
          "type": "string",
          "default": "out",
          "markdownDescription": "%config.outDir%"
        },
        "novelPreview.openAfterExport": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.openAfterExport%"
        },
        "novelPreview.show.backup": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.show.backup%"
        },
        "novelPreview.show.statusBar": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.show.statusBar%"
        },
        "novelPreview.show.outline": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.show.outline%"
        },
        "novelPreview.show.editorButtons": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.show.editorButtons%"
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "novelPreview.outline",
          "name": "%view.outline%",
          "when": "novelPreview.hasManuscript && config.novelPreview.show.outline",
          "icon": "$(book)"
        }
      ]
    }
  },
  "scripts": {
    "bundle": "esbuild src/extension.mjs src/novel-cli.mjs src/pdf-renderer.mjs --bundle --platform=node --format=cjs --target=node20 --external:vscode --define:import.meta.vitest=undefined --log-override:empty-import-meta=silent --outdir=dist --out-extension:.js=.cjs",
    "build": "pnpm run bundle && node -e \"const fs = require('fs'), path = require('path'); fs.rmSync('dist/viewer', { recursive: true, force: true }); fs.cpSync(path.join(path.dirname(require.resolve('@vivliostyle/viewer/package.json')), 'lib'), 'dist/viewer', { recursive: true }); fs.copyFileSync(path.join(path.dirname(require.resolve('lindera-wasm')), 'lindera_wasm_bg.wasm'), 'dist/lindera_wasm_bg.wasm'); fs.copyFileSync('../src/templates/tategaki-a4-42x34.docx', 'dist/tategaki-a4-42x34.docx')\" && node src/ipadic.mjs dist/ipadic",
    "watch": "pnpm run bundle --watch=forever",
    "package": "pnpm run build && npx --yes @vscode/vsce package --no-dependencies --baseContentUrl https://github.com/omni-stove/novel-kit/blob/HEAD/vscode --baseImagesUrl https://github.com/omni-stove/novel-kit/raw/HEAD/vscode -o dist/novel-preview.vsix",
    "install-extension": "pnpm run package && code --install-extension dist/novel-preview.vsix --force",
    "release": "pnpm --dir .. test && pnpm run package && gh release create \"vscode-v$npm_package_version\" dist/novel-preview.vsix --repo omni-stove/novel-kit --title \"小説プレビュー $npm_package_version\" --generate-notes",
    "publish": "pnpm run build && npx --yes @vscode/vsce publish --no-dependencies --baseContentUrl https://github.com/omni-stove/novel-kit/blob/HEAD/vscode --baseImagesUrl https://github.com/omni-stove/novel-kit/raw/HEAD/vscode"
  },
  "devDependencies": {
    "@puppeteer/browsers": "2.10.5",
    "@types/vscode": "~1.100.0",
    "@types/vscode-webview": "^1.57.5",
    "@vivliostyle/viewer": "2.42.1",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.2",
    "lindera-wasm": "6.2.0",
    "puppeteer-core": "24.27.0"
  },
  "keywords": [
    "小説",
    "縦書き",
    "ルビ",
    "原稿用紙",
    "PDF",
    "novel",
    "vertical writing",
    "manuscript",
    "Japanese",
    "Vivliostyle"
  ]
}
