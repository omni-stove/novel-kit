{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "小説プレビューの設定（レイアウト定義と表示設定）",
  "type": "object",
  "properties": {
    "language": {
      "enum": [
        "auto",
        "ja",
        "en"
      ],
      "description": "組版の言語（auto: 原稿の文字で判定。アルファベットが多ければ英語 / ja: 日本語 / en: English）"
    },
    "writingMode": {
      "enum": [
        "vertical",
        "horizontal"
      ],
      "description": "文字方向（縦書き / 横書き。英語組版は横書き固定）"
    },
    "paper": {
      "enum": [
        "A4",
        "B5",
        "A5",
        "B6",
        "A6",
        "6x9in",
        "5x8in"
      ],
      "description": "用紙サイズ（6x9in / 5x8in は英語ペーパーバックの判型）"
    },
    "orientation": {
      "enum": [
        "landscape",
        "portrait"
      ],
      "description": "用紙の向き"
    },
    "margin": {
      "type": "object",
      "description": "余白（mm）",
      "properties": {
        "top": {
          "type": "number"
        },
        "right": {
          "type": "number"
        },
        "bottom": {
          "type": "number"
        },
        "left": {
          "type": "number"
        }
      }
    },
    "chars": {
      "type": "integer",
      "minimum": 5,
      "maximum": 100,
      "description": "1行の文字数"
    },
    "lines": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 100,
      "description": "1ページの行数（null で行送り自動）"
    },
    "fontSize": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 5,
      "maximum": 40,
      "description": "英語組版の本文の文字サイズ（pt。null で 11pt）"
    },
    "lineHeight": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 1,
      "maximum": 3,
      "description": "英語組版の行送り（倍率。null で 1.4）"
    },
    "fontFamily": {
      "type": "string",
      "description": "本文フォント（空なら PDF 出力と同じ。日本語は明朝、英語は EB Garamond）"
    },
    "view": {
      "type": "object",
      "description": "表示設定",
      "properties": {
        "scope": {
          "enum": [
            "work",
            "file"
          ],
          "description": "表示範囲（work: 同じディレクトリの本文ファイルを連結 / file: 開いているファイルだけ）"
        },
        "zoom": {
          "description": "表示倍率（fit: 画面に合わせる / 数値: %）",
          "anyOf": [
            {
              "enum": [
                "fit"
              ]
            },
            {
              "enum": [
                "fit-width",
                "fit-page"
              ],
              "deprecated": true,
              "description": "旧い値。fit として扱う"
            },
            {
              "type": "number",
              "minimum": 10,
              "maximum": 400
            }
          ]
        },
        "edit": {
          "type": "boolean",
          "description": "プレビュー上で段落をクリックして編集する"
        }
      }
    }
  }
}
